# Multi-provider setup with automatic fallback. The app tries these in order
# — Groq, Cerebras, Gemini, OpenRouter, NVIDIA, DeepSeek, Hugging Face,
# Cloudflare, then Ollama (local) — and moves to the next one automatically
# if a provider is rate-limited or out of credits.
#
# You DON'T need all of these. Fill in whichever free keys you have; leave
# the rest blank/commented and they'll just be skipped. Ollama alone
# (no keys at all) also works fine on its own.

# Groq — fast, generous free tier. Get a key: https://console.groq.com/keys
# (llama-3.1-8b-instant was shut down by Groq on 2026-08-16 — gpt-oss-20b
# below is Groq's own recommended replacement.)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cerebras — very fast inference, free tier. Get a key: https://cloud.cerebras.ai
# (llama3.1-8b was deprecated by Cerebras on 2026-05-27 — gpt-oss-120b
# below is Cerebras' own recommended replacement.)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Gemini — free tier via Google's OpenAI-compatibility endpoint.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — routes to many models, several free. Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# NVIDIA NIM API catalog (cloud, not self-hosted). Get a key: https://build.nvidia.com
# Model slugs in NVIDIA's catalog change over time — double check yours there.
# (llama-3.1-nemotron-70b-instruct was retired by NVIDIA and now 404s —
# nemotron-nano-9b-v2 below is the current lightweight replacement.)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2

# DeepSeek — very cheap pay-as-you-go, 5M free tokens on new accounts.
# Get a key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Hugging Face — OpenAI-compatible router in front of many hosted models
# (Groq, Cerebras, DeepInfra, Fireworks, and more), free monthly inference
# credits on every account. Get a token (needs "Inference" permission, NOT
# "Write"): https://huggingface.co/settings/tokens
# Optionally pin a specific backing provider by suffixing the model id,
# e.g. "openai/gpt-oss-120b:groq" — left as "auto" here.
HF_API_KEY=
HF_MODEL=openai/gpt-oss-120b

# Cloudflare Workers AI — free tier is 10,000 "neurons"/day (not tokens —
# Cloudflare's own compute unit, shared across all model types), resets
# every day at 00:00 UTC. Needs BOTH values below, unlike the others.
# Account ID: right sidebar of any page in the Cloudflare dashboard.
# API Token: https://dash.cloudflare.com/profile/api-tokens — create one
# with "Workers AI" read/edit permission.
# (Not gpt-oss-120b here: Cloudflare's own docs call gpt-oss through the
# newer Responses API, not /v1/chat/completions used by this app — use
# llama-3.1-8b-instruct instead, which is Cloudflare's official example
# model for this exact endpoint and supports tool calling natively.)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Ollama — local, no key needed, no limit. Always used as the final fallback.
# Install: https://ollama.com/download   then:  ollama pull qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Context window sent to Ollama per request. Ollama defaults to only
# 2048-4096 tokens and silently truncates/forgets older messages beyond
# that -- raising this avoids that. 8192 is safe for most 7-8B local models;
# lower it if you hit VRAM/RAM limits.
OLLAMA_NUM_CTX=8192

PORT=3000

# ---- Optional: Google Drive backup for Custom Case uploads ----
# Lets a user connect their own Drive and auto-backup every docx they
# upload through the "Custom Case" feature into a folder they choose.
# Leave all three blank to just not offer this — the Custom Case feature
# itself (upload/convert/play) works fully without any of this.
#
# Setup: https://console.cloud.google.com -> new project -> enable
# "Google Drive API" -> "OAuth consent screen" (External is fine for
# personal use) -> "Credentials" -> "Create OAuth client ID" (type: Web
# application) -> add the exact GOOGLE_REDIRECT_URI below to
# "Authorized redirect URIs" -> copy the generated Client ID/Secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client, and
# must be reachable from whatever browser clicks "Hubungkan Google Drive"
# (so use your real deployed URL, not localhost, once this isn't running
# on your own machine).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
